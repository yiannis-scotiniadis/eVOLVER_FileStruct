[Unit]
Description=eVOLVER control server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/evolver-gui
EnvironmentFile=/etc/evolver/secret.env
ExecStart=/home/pi/evolver-gui/.venv/bin/python /home/pi/evolver-gui/server/app.py
Restart=on-failure
RestartSec=5
# Logs go to the journal here and to the rotating handlers the server installs
# itself (logs/evolver.log + logs/errors.log, SPEC §20.1). The previous
# `append:/var/log/evolver/app.log` was never rotated, so it grew without bound
# on the SD card the experiment data also lives on.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
